# Travelling Salesman Problem (TSP) using Dynamic Programming (Held-Karp)

INF = float('inf')

def tsp(graph):
    n = len(graph)
    # dp[mask][i] = minimum cost to reach set of cities "mask" ending at city i
    dp = [[INF] * n for _ in range(1 << n)]
    dp[1][0] = 0  # start at city 0

    for mask in range(1 << n):
        for u in range(n):
            if mask & (1 << u):  # if u is in mask
                for v in range(n):
                    if mask & (1 << v) == 0:  # if v not visited
                        new_mask = mask | (1 << v)
                        dp[new_mask][v] = min(
                            dp[new_mask][v],
                            dp[mask][u] + graph[u][v]
                        )

    # Close the tour: return to start (city 0)
    res = INF
    for u in range(1, n):
        res = min(res, dp[(1 << n) - 1][u] + graph[u][0])

    return res


# Example graph (Adjacency Matrix)
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

# Run TSP
min_cost = tsp(graph)
print("Minimum cost of travelling salesman tour:", min_cost)
